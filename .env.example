# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Payment Gateway Configuration
# RAZORPAY_KEY_ID: Razorpay Key ID (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET: Razorpay Merchant Secret for backend signatures & order generation
RAZORPAY_KEY_SECRET=
# VITE_RAZORPAY_KEY_ID: Client-facing Razorpay Key ID for checkout modal in Vite
VITE_RAZORPAY_KEY_ID=
# RAZORPAY_WEBHOOK_SECRET: Webhook verification secret for automated payment events
RAZORPAY_WEBHOOK_SECRET=

# Sample Demo Login Emails
# NOTE: If these variables are left blank or omitted, the sample demo login form is completely hidden.
# Option 1: Provide a comma-separated list of emails:
# VITE_SAMPLE_LOGIN_EMAILS="admin@hospital.in,owner@hospital.in,vendor@devices.in,advisor@consulting.in"
# Option 2: Provide individual role emails:
VITE_SAMPLE_ADMIN_EMAIL=
VITE_SAMPLE_OWNER_EMAIL=
VITE_SAMPLE_VENDOR_EMAIL=
VITE_SAMPLE_ADVISOR_EMAIL=
# Optional default demo password & admin key for sample accounts
VITE_SAMPLE_DEFAULT_PASSWORD=
VITE_SAMPLE_ADMIN_KEY=

